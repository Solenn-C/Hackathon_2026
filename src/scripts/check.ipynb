    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import os\n",
    "sil_dir = Path(\"../../data/silver\")\n",
    "print(os.getcwd())\n",
    "for file in sil_dir.glob(\"*.parquet\"):\n",
    "    df = pd.read_parquet(file)\n",
    "    display(df.head())"
   ]
